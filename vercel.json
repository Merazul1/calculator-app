{
  "redirects": [
    {
      "source": "/auto-loan",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/car-loan",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/car-payment-calculator",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/mortgage",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/mortgage-cost-estimator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/mortgage-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/real-estate/mortgage-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/auto/car-lease-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/dividend-calculator",
      "destination": "/compound",
      "permanent": true
    },
    {
      "source": "/calculators/investing/stock-profit-calculator",
      "destination": "/compound",
      "permanent": true
    },
    {
      "source": "/calculators",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calculators/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/overview",
      "destination": "/about",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/salary",
      "destination": "/salary.html"
    },
    {
      "source": "/loan",
      "destination": "/loan.html"
    },
    {
      "source": "/autoloan",
      "destination": "/autoloan.html"
    },
    {
      "source": "/currency",
      "destination": "/currency.html"
    },
    {
      "source": "/bmi",
      "destination": "/bmi.html"
    },
    {
      "source": "/compound",
      "destination": "/compound.html"
    },
    {
      "source": "/percentage",
      "destination": "/percentage.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "text/xsl; charset=utf-8" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
