{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.smartcalclab.com"
        }
      ],
      "destination": "https://smartcalclab.com/:path*",
      "permanent": true
    },
    {
      "source": "/auto-loan",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/car-loan",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/car-payment-calculator",
      "destination": "/autoloan",
      "permanent": true
    },
    {
      "source": "/mortgage",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/mortgage-cost-estimator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/mortgage-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/real-estate/mortgage-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/auto/car-lease-calculator",
      "destination": "/loan",
      "permanent": true
    },
    {
      "source": "/calculators/dividend-calculator",
      "destination": "/compound",
      "permanent": true
    },
    {
      "source": "/calculators/investing/stock-profit-calculator",
      "destination": "/compound",
      "permanent": true
    },
    {
      "source": "/calculators",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calculators/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/overview",
      "destination": "/about",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/loan",
      "has": [{ "type": "query", "key": "lang", "value": "es" }],
      "destination": "/loan-es"
    },
    {
      "source": "/loan",
      "has": [{ "type": "query", "key": "lang", "value": "ar" }],
      "destination": "/loan-ar"
    },
    {
      "source": "/compound",
      "has": [{ "type": "query", "key": "lang", "value": "es" }],
      "destination": "/compound-es"
    },
    {
      "source": "/salary",
      "has": [{ "type": "query", "key": "lang", "value": "es" }],
      "destination": "/salary-es"
    },
    {
      "source": "/salary",
      "has": [{ "type": "query", "key": "lang", "value": "pt" }],
      "destination": "/salary-pt"
    },
    {
      "source": "/bmi",
      "has": [{ "type": "query", "key": "lang", "value": "es" }],
      "destination": "/bmi-es"
    },
    {
      "source": "/salary",
      "destination": "/salary.html"
    },
    {
      "source": "/loan",
      "destination": "/loan.html"
    },
    {
      "source": "/autoloan",
      "destination": "/autoloan.html"
    },
    {
      "source": "/currency",
      "destination": "/currency.html"
    },
    {
      "source": "/bmi",
      "destination": "/bmi.html"
    },
    {
      "source": "/compound",
      "destination": "/compound.html"
    },
    {
      "source": "/percentage",
      "destination": "/percentage.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/guides/mortgage-amortization-piti-guide",
      "destination": "/guides/mortgage-amortization-piti-guide.html"
    },
    {
      "source": "/guides/gross-vs-net-salary-guide",
      "destination": "/guides/gross-vs-net-salary-guide.html"
    },
    {
      "source": "/guides/auto-loan-financing-guide",
      "destination": "/guides/auto-loan-financing-guide.html"
    },
    {
      "source": "/guides/compound-interest-wealth-guide",
      "destination": "/guides/compound-interest-wealth-guide.html"
    },
    {
      "source": "/guides/bmi-body-composition-guide",
      "destination": "/guides/bmi-body-composition-guide.html"
    },
    {
      "source": "/guides/currency-exchange-bank-fees-guide",
      "destination": "/guides/currency-exchange-bank-fees-guide.html"
    },
    {
      "source": "/guides/:path*",
      "destination": "/guides/:path*.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "all" }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "text/xsl; charset=utf-8" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
